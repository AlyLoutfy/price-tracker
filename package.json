{
  "name": "price-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Price Tracker: Telegram alerts for Dubizzle listings and ASICS France discounts.",
  "scripts": {
    "start": "tsx src/run.ts",
    "dry-run": "DRY_RUN=1 tsx src/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "telegram:test": "tsx src/test-telegram.ts",
    "test:browser": "TEST_BROWSER=1 vitest run test/browser.spec.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "1.61.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
